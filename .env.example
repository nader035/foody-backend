# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local example: mongodb://127.0.0.1:27017/foody
# Atlas example: mongodb+srv://<user>:<password>@<cluster-url>/foody?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/foody

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# Frontend URL(s), comma-separated
# Example for Railway + local frontend:
# CORS_ORIGIN=https://foodyyy.vercel.app,https://foody-frontend-blond.vercel.app,http://localhost:3000
CORS_ORIGIN=https://foodyyy.vercel.app,https://foody-frontend-blond.vercel.app,http://localhost:3000
